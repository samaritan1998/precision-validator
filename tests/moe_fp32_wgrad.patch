     native = helper()
     dtype = getattr(torch, case['dtype'])
+    if case.get('native_fp32_wgrad'):
+        return native_fp32_wgrad_model(case['kind'], layout, dtype=dtype, position_embedding_type='rope', sequence_length=64)
     if case['kind'] != 'cp':
         return native.model_for(case['kind'], layout, dtype=dtype, position_embedding_type='rope', sequence_length=64)
     from megatron.core import parallel_state as ps
